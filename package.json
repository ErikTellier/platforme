{
  "name": "platforme",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "^24.20.0",
    "pnpm": "^11.23.0"
  },
  "scripts": {
    "build": "turbo run build",
    "migrate": "node packages/harnais/migrer.mjs up",
    "migrate:down": "node packages/harnais/migrer.mjs down",
    "migrate:status": "node packages/harnais/migrer.mjs up --dry-run",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "knip": "knip",
    "verifier:paquets": "node packages/harnais/verifier-paquets.mjs",
    "test": "turbo run test",
    "test:db": "node packages/harnais/pgtap.mjs",
    "mutation": "turbo run mutation",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "@types/pg": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "node-pg-migrate": "catalog:",
    "pg": "catalog:",
    "prettier": "catalog:",
    "secretlint": "catalog:",
    "turbo": "catalog:"
  }
}
